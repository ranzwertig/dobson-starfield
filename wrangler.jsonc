{
  // Static site from dist/ (website at /, app at /app/, unknown paths get dist/404.html).
  // The Worker (worker/index.js) only runs for /api/*: satellite orbital data for the app (from CelesTrak, twice a day)
  // and sync between devices (worker/sync.js, end-to-end encrypted copies in the D1 database SYNC_DB).
  // "build" makes wrangler deploy/dev run npm run build first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dobson-starfield",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Sync: at most 60 requests a minute per IP address (counted in memory by Cloudflare, nothing is stored)
  "ratelimits": [
    { "name": "SYNC_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
  // Sync needs a D1 database. Without it the app hides sync (the API answers 503). Create it once, in the EU:
  //   npx wrangler d1 create zenigo-sync --jurisdiction eu
  // and add the binding here (the table is created on first use):
  // "d1_databases": [{ "binding": "SYNC_DB", "database_name": "zenigo-sync", "database_id": "<id from the command>" }]
}
