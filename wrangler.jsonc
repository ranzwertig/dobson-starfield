{
  // Static site: Cloudflare serves dist/ directly, without Worker code.
  // "build" makes wrangler deploy/dev run npm run build first.
  // Website at /, app at /app/, unknown paths get dist/404.html.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dobson-starfield",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
