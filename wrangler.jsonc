{
  // Static site from dist/ (website at /, app at /app/, unknown paths get dist/404.html).
  // The Worker (worker/index.js) only runs for /api/*: satellite orbital data for the app (from CelesTrak, twice a day)
  // and sync between devices (worker/sync.js, end-to-end encrypted copies in the D1 database SYNC_DB); and for the night
  // sky of this week, /sky/ and /de/sky/, which show the week of the day (worker/sky.js).
  // "build" makes wrangler deploy/dev run npm run build first.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dobson-starfield",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/sky", "/sky/", "/de/sky", "/de/sky/", "/sky-now/*"]
  },
  // Sync: at most 60 requests a minute per IP address (counted in memory by Cloudflare, nothing is stored)
  "ratelimits": [
    { "name": "SYNC_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Licence lookups on the welcome page (/api/pro/licence): at most 30 a minute per IP address
    { "name": "PRO_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  // Zenigo Pro page (/pro/, worker/pro.js): Paddle environment, client-side token and the price of "Zenigo Pro –
  // 12-month licence". All three are public (the page sends them to the browser), so they live here and not as secrets.
  // Live values here (zenigo.app); the previews block below keeps the sandbox ones.
  // Without PADDLE_ENV the page shows "Checkout unavailable" (no default, so the site never uses the wrong account).
  // Locally, .dev.vars overrides them (see .dev.vars.example).
  // Licence keys (worker/licence.js) need two secrets, never in this file: PADDLE_WEBHOOK_SECRET (signing secret of the
  // Paddle notification destination) and PRO_SIGNING_KEY (private key, JWK); set them with `npx wrangler secret put …`
  // or in the dashboard (Settings → Variables and Secrets, type Secret). No Paddle API key is needed.
  // SYNC_NEEDS_PRO "true": reading and writing sync groups needs a running Pro licence.
  "vars": {
    "SYNC_NEEDS_PRO": "true",
    "PADDLE_ENV": "production",
    "PADDLE_CLIENT_TOKEN": "live_3cd51c72dc16f3ae91f96a57661",
    "PADDLE_PRICE_ID": "pri_01m5y5w7dtbkpfnsxhgyjjdbjp"
  },
  // Preview builds of branches other than main (Workers Builds runs `npx wrangler preview`, which needs this block):
  // Paddle sandbox, the same sync database (only encrypted copies) and a separate rate-limit namespace.
  "previews": {
    "vars": {
      "SYNC_NEEDS_PRO": "true",
      "PADDLE_ENV": "sandbox",
      "PADDLE_CLIENT_TOKEN": "test_286c8d85575e79e87f6f084c045",
      "PADDLE_PRICE_ID": "pri_01m5w5v6s354efkqesfcebsr41"
    },
    "d1_databases": [
      { "binding": "SYNC_DB", "database_name": "zenigo-sync", "database_id": "a7df21e9-3e67-4ee0-84a8-8bc8930d0198" }
    ],
    "ratelimits": [
      { "name": "SYNC_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
      { "name": "PRO_LIMIT", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } }
    ]
  },
  // Sync: D1 database in the EU (created with npx wrangler d1 create zenigo-sync --jurisdiction eu).
  // Without it the app hides sync (the API answers 503). The table is created on first use.
  "d1_databases": [
    { "binding": "SYNC_DB", "database_name": "zenigo-sync", "database_id": "a7df21e9-3e67-4ee0-84a8-8bc8930d0198" }
  ]
}
