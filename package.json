{
  "name": "dobson-starfield",
  "version": "0.1.0",
  "private": true,
  "description": "Zenigo: plate-solving web app for push-to telescope navigation",
  "scripts": {
    "catalog": "node scripts/catalog.mjs",
    "build": "node scripts/catalog.mjs && node scripts/build.mjs",
    "test": "npm run catalog && node test/synthetic.cjs 21 2",
    "test:photo": "node test/photo.cjs",
    "test:sync": "node test/sync.cjs",
    "test:pro": "node test/pro-config.mjs && node --no-warnings test/licence.mjs",
    "test:ui": "PRO_TEST_KEY=1 SKY_DRAFTS=1 node scripts/build.mjs && node test/ui-par.cjs",
    "test:sky": "node --no-warnings test/sky.mjs",
    "sky:validate": "node scripts/sky.mjs validate",
    "sky:candidates": "node scripts/sky.mjs candidates",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test:ui:serial": "PRO_TEST_KEY=1 SKY_DRAFTS=1 node scripts/build.mjs && node test/ui.cjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/saira-semi-condensed": "^5.1.0",
    "@jscad/modeling": "2.13.0",
    "astronomy-engine": "2.1.19",
    "d3-celestial": "0.7.35",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "satellite.js": "^6.0.2",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=20"
  }
}
